<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F9F9FB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <include
            android:id="@+id/header"
            layout="@layout/include_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/book_appointment_title"
            android:padding="10dp"
            android:textColor="#0F172A"
            android:textSize="20sp"
            android:textStyle="bold" />


        <!-- Booking Form Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="20dp">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">


                <!-- Title -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/schedule_your_appointment"
                    android:textColor="#0F172A"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="20dp" />


                <!-- Doctor Type -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/select_doctor_type"
                    android:textColor="#0F172A"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="20dp">


                    <Button
                        android:id="@+id/btnChoSelect"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="45dp"
                        android:text="@string/cho"
                        android:textSize="14sp"
                        android:backgroundTint="#E8F5E9"
                        android:textColor="#1B5E20"
                        android:layout_marginEnd="8dp" />


                    <Button
                        android:id="@+id/btnMoSelect"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="45dp"
                        android:text="@string/mo"
                        android:textSize="14sp"
                        android:backgroundTint="#F5F5F5"
                        android:textColor="#424242" />

                </LinearLayout>


                <!-- Doctor Name -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/doctor_name"
                    android:textColor="#0F172A"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />


                <EditText
                    android:id="@+id/etDoctorName"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:hint="@string/doctor_name_hint"
                    android:enabled="false"
                    android:background="@drawable/bg_edittext_rounded"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:inputType="textPersonName"
                    android:textSize="15sp"
                    android:layout_marginBottom="16dp" />


                <!-- Doctor Phone -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/doctor_phone"
                    android:textColor="#0F172A"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />


                <EditText
                    android:id="@+id/etDoctorPhone"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:hint="@string/phone_number_hint"
                    android:enabled="false"
                    android:background="@drawable/bg_edittext_rounded"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:inputType="phone"
                    android:textSize="15sp"
                    android:layout_marginBottom="16dp" />


                <!-- Date -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/appointment_date"
                    android:textColor="#0F172A"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />


                <EditText
                    android:id="@+id/etAppointmentDate"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:hint="@string/date_format_hint"
                    android:background="@drawable/bg_edittext_rounded"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:inputType="date"
                    android:textSize="15sp"
                    android:layout_marginBottom="16dp" />


                <!-- Time -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/appointment_time_optional"
                    android:textColor="#0F172A"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />


                <EditText
                    android:id="@+id/etAppointmentTime"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:hint="@string/time_format_hint"
                    android:background="@drawable/bg_edittext_rounded"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:inputType="time"
                    android:textSize="15sp"
                    android:layout_marginBottom="16dp" />


                <!-- Notes -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/notes_optional"
                    android:textColor="#0F172A"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />


                <EditText
                    android:id="@+id/etNotes"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:hint="@string/notes_hint"
                    android:background="@drawable/bg_edittext_rounded"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="10dp"
                    android:inputType="textMultiLine"
                    android:textSize="15sp"
                    android:gravity="top"
                    android:layout_marginBottom="20dp" />


                <!-- Save -->
                <Button
                    android:id="@+id/btnSaveAppointment"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="@string/save_appointment"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:backgroundTint="#22C55E" />


            </LinearLayout>

        </androidx.cardview.widget.CardView>


        <!-- Saved -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/saved_appointments"
            android:textColor="#0F172A"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSavedAppointments"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:clipToPadding="false"
            android:paddingBottom="16dp" />


        <!-- Empty State -->
        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">


            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/ic_calendar"
                android:contentDescription="@string/no_appointments_icon_desc"
                android:layout_marginBottom="12dp"
                app:tint="#CBD5E1" />


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/no_appointments"
                android:textAlignment="center"
                android:textColor="#64748B"
                android:textSize="14sp" />

        </LinearLayout>


    </LinearLayout>

</ScrollView>