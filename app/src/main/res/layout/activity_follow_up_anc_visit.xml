<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@android:color/white"
    tools:context=".asha.ui.surveys.pregnancy.FollowUpAncVisitActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Patient Header Section -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardElevation="2dp"
            app:cardCornerRadius="8dp"
            app:contentPadding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Patient Details"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/tvPatientNameHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Name: -"
                    android:textSize="14sp"
                    android:textColor="@android:color/black"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvPatientPhoneHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Phone: -"
                    android:textSize="14sp"
                    android:textColor="@android:color/black"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvPatientGenderHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gender: -"
                    android:textSize="14sp"
                    android:textColor="@android:color/black"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvPatientWeightHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Weight: -"
                    android:textSize="14sp"
                    android:textColor="@android:color/black" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Visit Details Section -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardElevation="2dp"
            app:cardCornerRadius="8dp"
            app:contentPadding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Visit Details"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"
                    android:layout_marginBottom="12dp" />

                <!-- Visit Date -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilVisitDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Visit Date*"
                    android:layout_marginBottom="8dp"
                    app:endIconMode="custom"
                    app:endIconDrawable="@android:drawable/ic_menu_my_calendar">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etVisitDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:clickable="true"
                        android:inputType="none" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Visit Number -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilVisitNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Visit Number (2, 3, 4, ...)*"
                    android:layout_marginBottom="8dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etVisitNumber"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLength="2" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Facility Type -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Facility Type*"
                    android:textSize="14sp"
                    android:textColor="@android:color/black"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp" />

                <RadioGroup
                    android:id="@+id/rgFacilityType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rbFacilityGovt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Govt facility"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rbFacilityPrivate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Private"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rbFacilityHome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Home visit"
                        android:textSize="14sp" />

                </RadioGroup>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Current Condition Section -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardElevation="2dp"
            app:cardCornerRadius="8dp"
            app:contentPadding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Current Condition"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"
                    android:layout_marginBottom="12dp" />

                <!-- Symptoms Today -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Symptoms today (select all that apply):"
                    android:textSize="14sp"
                    android:textColor="@android:color/black"
                    android:layout_marginBottom="8dp" />

                <CheckBox
                    android:id="@+id/cbSymptomBleeding"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vaginal bleeding"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/cbSymptomHeadacheBlurredVision"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Severe headache / blurred vision"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/cbSymptomSwelling"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Swelling of face / hands"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/cbSymptomFeverChills"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fever with chills"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/cbSymptomReducedMovements"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reduced baby movements (after 7 months)"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/cbSymptomSevereAbdominalPain"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Severe abdominal pain"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/cbSymptomNone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="None of the above"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp" />

                <!-- BP Recorded Switch -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="BP recorded?"
                        android:textSize="14sp"
                        android:textColor="@android:color/black" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchBpRecorded"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <!-- BP Systolic -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilBpSystolic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Systolic (mmHg)"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etBpSystolic"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLength="3" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- BP Diastolic -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilBpDiastolic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Diastolic (mmHg)"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etBpDiastolic"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLength="3" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Weight -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilWeightKg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Weight (kg)"
                    android:layout_marginTop="8dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etWeightKg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:maxLength="5" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Interventions Section -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardElevation="2dp"
            app:cardCornerRadius="8dp"
            app:contentPadding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Interventions"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"
                    android:layout_marginBottom="12dp" />

                <!-- IFA Tablets -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilIfaTablets"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="IFA tablets given"
                    android:layout_marginBottom="8dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etIfaTablets"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLength="3" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Calcium Tablets -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilCalciumTablets"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Calcium tablets given"
                    android:layout_marginBottom="8dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCalciumTablets"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLength="3" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- TT/TD Dose -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilTtDose"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="TT/TD dose"
                    android:layout_marginBottom="8dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">

                    <AutoCompleteTextView
                        android:id="@+id/autoTtDose"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:text="None" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Referral Made Switch -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Any referral made?"
                        android:textSize="14sp"
                        android:textColor="@android:color/black" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchReferralMade"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <!-- Referral Reason -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilReferralReason"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Referral reason"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etReferralReason"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapSentences"
                        android:maxLength="100" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Next Visit Date -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilNextVisitDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Next visit date (optional)"
                    android:layout_marginTop="8dp"
                    app:endIconMode="custom"
                    app:endIconDrawable="@android:drawable/ic_menu_my_calendar">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etNextVisitDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:focusableInTouchMode="false"
                        android:clickable="true"
                        android:inputType="none" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Save Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveFollowUpAnc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Follow-up Visit"
            android:textSize="16sp"
            android:padding="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>

