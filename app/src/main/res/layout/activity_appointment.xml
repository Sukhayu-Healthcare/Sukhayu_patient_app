<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp">

    <TextView android:id="@+id/textViewAppointmentTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Book Appointment" android:textSize="20sp" android:textStyle="bold" android:layout_marginBottom="16dp" />

    <EditText android:id="@+id/etDoctorName" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Doctor Name" android:layout_marginBottom="8dp" />

    <EditText android:id="@+id/etDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Date" android:layout_marginBottom="8dp" />

    <Button android:id="@+id/btnBookAppointment" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Book Appointment" />

</LinearLayout>
