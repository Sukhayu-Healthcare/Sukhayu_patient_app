<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#F5F5F5">

    <!-- Include Header -->
    <include layout="@layout/include_header" />

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

            <!-- Profile Card -->
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" app:cardCornerRadius="12dp" app:cardElevation="2dp" app:strokeWidth="0dp" app:cardBackgroundColor="#FFFFFF">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">

                        <ImageView android:id="@+id/imgProfile" android:layout_width="64dp" android:layout_height="64dp" android:src="@drawable/ic_person_outline" android:background="@drawable/circle_background" android:padding="12dp" android:contentDescription="Profile Picture" android:layout_marginEnd="16dp"/>

                        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">

                            <TextView android:id="@+id/tvAshaName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ASHA Name" android:textSize="18sp" android:textStyle="bold" android:textColor="#1F1F1F"/>

                            <TextView android:id="@+id/tvAshaId" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ID: ASHA001" android:textSize="14sp" android:textColor="#757575" android:layout_marginTop="4dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <Button android:id="@+id/btnLogout" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Logout" android:textColor="#FFFFFF" android:textStyle="bold" android:backgroundTint="#DC2626" android:layout_marginTop="16dp" app:cornerRadius="8dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Select Survey Type" android:textSize="18sp" android:textStyle="bold" android:textColor="#1F1F1F" android:layout_marginBottom="16dp"/>

            <!-- Pregnancy / ANC Survey Card -->
            <com.google.android.material.card.MaterialCardView android:id="@+id/btnPregnancySurvey" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:clickable="true" android:focusable="true" app:cardCornerRadius="12dp" app:cardElevation="2dp" app:strokeWidth="0dp" app:cardBackgroundColor="#FFF1F2">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="16dp" android:gravity="center_vertical">

                    <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_person_outline" app:tint="#BE123C" android:contentDescription="Pregnancy Survey" android:layout_marginEnd="16dp"/>

                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pregnancy / ANC Survey" android:textSize="16sp" android:textStyle="bold" android:textColor="#881337"/>

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="First visit &amp; follow-up" android:textSize="13sp" android:textColor="#9F1239" android:layout_marginTop="4dp"/>
                    </LinearLayout>

                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_open_in_new" app:tint="#BE123C" android:contentDescription="Open"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Child Health & Immunisation Survey Card -->
            <com.google.android.material.card.MaterialCardView android:id="@+id/btnChildSurvey" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:clickable="true" android:focusable="true" app:cardCornerRadius="12dp" app:cardElevation="2dp" app:strokeWidth="0dp" app:cardBackgroundColor="#DBEAFE">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="16dp" android:gravity="center_vertical">

                    <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_person_add" app:tint="#1E40AF" android:contentDescription="Child Survey" android:layout_marginEnd="16dp"/>

                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Child Health &amp; Immunisation" android:textSize="16sp" android:textStyle="bold" android:textColor="#1E3A8A"/>

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Growth monitoring &amp; vaccines" android:textSize="13sp" android:textColor="#1E40AF" android:layout_marginTop="4dp"/>
                    </LinearLayout>

                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_open_in_new" app:tint="#1E40AF" android:contentDescription="Open"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- TB Symptoms Survey Card -->
            <com.google.android.material.card.MaterialCardView android:id="@+id/btnTbSurvey" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:clickable="true" android:focusable="true" app:cardCornerRadius="12dp" app:cardElevation="2dp" app:strokeWidth="0dp" app:cardBackgroundColor="#FEF3C7">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="16dp" android:gravity="center_vertical">

                    <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_stethoscope" app:tint="#B45309" android:contentDescription="TB Survey" android:layout_marginEnd="16dp"/>

                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TB Symptoms Survey" android:textSize="16sp" android:textStyle="bold" android:textColor="#78350F"/>

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Screening for tuberculosis" android:textSize="13sp" android:textColor="#92400E" android:layout_marginTop="4dp"/>
                    </LinearLayout>

                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_open_in_new" app:tint="#B45309" android:contentDescription="Open"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- NCD Screening Card -->
            <com.google.android.material.card.MaterialCardView android:id="@+id/btnNcdSurvey" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:clickable="true" android:focusable="true" app:cardCornerRadius="12dp" app:cardElevation="2dp" app:strokeWidth="0dp" app:cardBackgroundColor="#D1FAE5">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="16dp" android:gravity="center_vertical">

                    <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_heart" app:tint="#047857" android:contentDescription="NCD Survey" android:layout_marginEnd="16dp"/>

                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NCD Screening" android:textSize="16sp" android:textStyle="bold" android:textColor="#065F46"/>

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="BP / Diabetes screening" android:textSize="13sp" android:textColor="#047857" android:layout_marginTop="4dp"/>
                    </LinearLayout>

                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_open_in_new" app:tint="#047857" android:contentDescription="Open"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
