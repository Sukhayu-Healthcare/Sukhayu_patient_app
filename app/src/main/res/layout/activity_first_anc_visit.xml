<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@android:color/white"
    tools:context=".asha.ui.surveys.pregnancy.FirstAncVisitActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Patient Header Section -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardElevation="2dp"
            app:cardCornerRadius="8dp"
            app:contentPadding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Patient Details"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/tvPatientNameHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Name: -"
                    android:textSize="14sp"
                    android:textColor="@android:color/black"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvPatientPhoneHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Phone: -"
                    android:textSize="14sp"
                    android:textColor="@android:color/black"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvPatientGenderHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gender: -"
                    android:textSize="14sp"
                    android:textColor="@android:color/black"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvPatientWeightHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Weight: -"
                    android:textSize="14sp"
                    android:textColor="@android:color/black" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Pregnancy Basics Section -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardElevation="2dp"
            app:cardCornerRadius="8dp"
            app:contentPadding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pregnancy Basics"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"
                    android:layout_marginBottom="12dp" />

                <!-- LMP Date -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilLmpDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="LMP Date (Last Menstrual Period)"
                    android:layout_marginBottom="8dp"
                    app:endIconMode="custom"
                    app:endIconDrawable="@android:drawable/ic_menu_my_calendar">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etLmpDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:clickable="true"
                        android:inputType="none" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- EDD Date -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilEddDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="EDD (Expected Delivery Date)"
                    android:layout_marginBottom="8dp"
                    app:endIconMode="custom"
                    app:endIconDrawable="@android:drawable/ic_menu_my_calendar">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etEddDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:clickable="true"
                        android:inputType="none" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Gravida -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilGravida"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Gravida (Total Pregnancies)"
                    android:layout_marginBottom="8dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etGravida"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLength="2" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Para -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPara"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Para (Previous Deliveries)"
                    android:layout_marginBottom="8dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPara"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLength="2" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Living Children -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilLivingChildren"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Living Children"
                    android:layout_marginBottom="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etLivingChildren"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLength="2" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Previous Complication Switch -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Previous serious complication?"
                        android:textSize="14sp"
                        android:textColor="@android:color/black" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchPreviousComplication"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <!-- Previous Complication Note -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPreviousComplicationNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Complication details"
                    android:visibility="gone">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPreviousComplicationNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapSentences"
                        android:maxLength="100" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Current Risk Screening Section -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardElevation="2dp"
            app:cardCornerRadius="8dp"
            app:contentPadding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Current Risk Screening"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"
                    android:layout_marginBottom="12dp" />

                <!-- Severe Bleeding Switch -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Any severe bleeding now?"
                        android:textSize="14sp"
                        android:textColor="@android:color/black" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchSevereBleedingNow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <!-- Convulsions History Switch -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Convulsions / fits now or in past pregnancy?"
                        android:textSize="14sp"
                        android:textColor="@android:color/black" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchConvulsionsHistory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <!-- High BP History Switch -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="High BP in earlier pregnancy?"
                        android:textSize="14sp"
                        android:textColor="@android:color/black" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchHighBpHistory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <!-- Known Serious Illness Label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Known serious illness (select all that apply):"
                    android:textSize="14sp"
                    android:textColor="@android:color/black"
                    android:layout_marginBottom="8dp" />

                <!-- ChipGroup for Serious Illness -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupSeriousIllness"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    app:singleSelection="false">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipIllnessDiabetes"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Diabetes" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipIllnessHighBp"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="High BP" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipIllnessHeartDisease"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Heart disease" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipIllnessTb"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TB" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipIllnessHiv"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HIV" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipIllnessOther"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Other" />

                </com.google.android.material.chip.ChipGroup>

                <!-- Other Illness Details -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilSeriousIllnessOther"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Please specify other illness"
                    android:visibility="gone">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSeriousIllnessOther"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapSentences"
                        android:maxLength="100" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ANC & Delivery Plan Section -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardElevation="2dp"
            app:cardCornerRadius="8dp"
            app:contentPadding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ANC &amp; Delivery Plan"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"
                    android:layout_marginBottom="12dp" />

                <!-- First ANC Visit Date -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilFirstAncDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="First ANC Visit Date (Today)"
                    android:layout_marginBottom="12dp"
                    app:endIconMode="custom"
                    app:endIconDrawable="@android:drawable/ic_menu_my_calendar">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etFirstAncDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:clickable="true"
                        android:inputType="none" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Place of ANC Care -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Place of ANC Care:"
                    android:textSize="14sp"
                    android:textColor="@android:color/black"
                    android:layout_marginBottom="8dp" />

                <RadioGroup
                    android:id="@+id/rgAncPlace"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="12dp">

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rbAncPlaceGovt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Govt facility"
                        android:textSize="14sp" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rbAncPlacePrivate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Private"
                        android:textSize="14sp" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rbAncPlaceNotDecided"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Not decided"
                        android:textSize="14sp" />

                </RadioGroup>

                <!-- Planned Place of Delivery -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Planned Place of Delivery:"
                    android:textSize="14sp"
                    android:textColor="@android:color/black"
                    android:layout_marginBottom="8dp" />

                <RadioGroup
                    android:id="@+id/rgDeliveryPlace"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rbDeliveryPlaceGovt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Govt"
                        android:textSize="14sp" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rbDeliveryPlacePrivate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Private"
                        android:textSize="14sp" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rbDeliveryPlaceHome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Home"
                        android:textSize="14sp" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rbDeliveryPlaceNotDecided"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Not decided"
                        android:textSize="14sp" />

                </RadioGroup>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Counselling Section -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardElevation="2dp"
            app:cardCornerRadius="8dp"
            app:contentPadding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Counselling"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"
                    android:layout_marginBottom="12dp" />

                <!-- Danger Signs Explained Switch -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Danger signs explained?"
                        android:textSize="14sp"
                        android:textColor="@android:color/black" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchDangerSignsExplained"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <!-- Next Visit Date -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilNextVisitDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Next Visit Date (Optional)"
                    app:endIconMode="custom"
                    app:endIconDrawable="@android:drawable/ic_menu_my_calendar">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etNextVisitDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:clickable="true"
                        android:inputType="none" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Save Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveFirstAnc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save First ANC Visit"
            android:textSize="16sp"
            android:padding="16dp"
            app:cornerRadius="8dp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>

