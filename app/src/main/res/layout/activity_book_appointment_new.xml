<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F9F9FB">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

        <!-- Header -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:background="@android:color/white" android:elevation="2dp" android:layout_marginBottom="20dp">

            <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/asha_jyoti_logo" android:contentDescription="@string/app_name" android:layout_marginEnd="12dp" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Book Appointment" android:textColor="#0F172A" android:textSize="20sp" android:textStyle="bold" />
        </LinearLayout>

        <!-- Booking Form Card -->
        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="12dp" app:cardElevation="4dp" android:layout_marginBottom="20dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">

                <!-- Title -->
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Schedule Your Appointment" android:textColor="#0F172A" android:textSize="18sp" android:textStyle="bold" android:layout_marginBottom="20dp" />

                <!-- Doctor Type Selection -->
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Select Doctor Type" android:textColor="#0F172A" android:textSize="14sp" android:textStyle="bold" android:layout_marginBottom="8dp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="20dp">

                    <Button android:id="@+id/btnChoSelect" android:layout_width="0dp" android:layout_weight="1" android:layout_height="45dp" android:text="CHO" android:textSize="14sp" android:backgroundTint="#E8F5E9" android:textColor="#1B5E20" android:layout_marginEnd="8dp" />

                    <Button android:id="@+id/btnMoSelect" android:layout_width="0dp" android:layout_weight="1" android:layout_height="45dp" android:text="MO" android:textSize="14sp" android:backgroundTint="#F5F5F5" android:textColor="#424242" />
                </LinearLayout>

                <!-- Doctor Name -->
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Doctor Name" android:textColor="#0F172A" android:textSize="14sp" android:textStyle="bold" android:labelFor="@id/etDoctorName" android:layout_marginBottom="8dp" />

                <EditText android:id="@+id/etDoctorName" android:layout_width="match_parent" android:layout_height="45dp" android:hint="Doctor's name" android:enabled="false" android:background="@drawable/bg_edittext_rounded" android:paddingStart="14dp" android:paddingEnd="14dp" android:inputType="textPersonName" android:textSize="15sp" android:layout_marginBottom="16dp" />

                <!-- Doctor Phone -->
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Doctor Phone" android:textColor="#0F172A" android:textSize="14sp" android:textStyle="bold" android:labelFor="@id/etDoctorPhone" android:layout_marginBottom="8dp" />

                <EditText android:id="@+id/etDoctorPhone" android:layout_width="match_parent" android:layout_height="45dp" android:hint="Phone number" android:enabled="false" android:background="@drawable/bg_edittext_rounded" android:paddingStart="14dp" android:paddingEnd="14dp" android:inputType="phone" android:textSize="15sp" android:layout_marginBottom="16dp" />

                <!-- Appointment Date -->
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Appointment Date" android:textColor="#0F172A" android:textSize="14sp" android:textStyle="bold" android:labelFor="@id/etAppointmentDate" android:layout_marginBottom="8dp" />

                <EditText android:id="@+id/etAppointmentDate" android:layout_width="match_parent" android:layout_height="45dp" android:hint="yyyy-MM-dd" android:background="@drawable/bg_edittext_rounded" android:paddingStart="14dp" android:paddingEnd="14dp" android:inputType="date" android:textSize="15sp" android:layout_marginBottom="16dp" />

                <!-- Appointment Time -->
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Appointment Time (Optional)" android:textColor="#0F172A" android:textSize="14sp" android:textStyle="bold" android:labelFor="@id/etAppointmentTime" android:layout_marginBottom="8dp" />

                <EditText android:id="@+id/etAppointmentTime" android:layout_width="match_parent" android:layout_height="45dp" android:hint="HH:mm" android:background="@drawable/bg_edittext_rounded" android:paddingStart="14dp" android:paddingEnd="14dp" android:inputType="time" android:textSize="15sp" android:layout_marginBottom="16dp" />

                <!-- Notes -->
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Notes (Optional)" android:textColor="#0F172A" android:textSize="14sp" android:textStyle="bold" android:labelFor="@id/etNotes" android:layout_marginBottom="8dp" />

                <EditText android:id="@+id/etNotes" android:layout_width="match_parent" android:layout_height="80dp" android:hint="Add any notes or special requests" android:background="@drawable/bg_edittext_rounded" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="10dp" android:inputType="textMultiLine" android:textSize="15sp" android:gravity="top" android:layout_marginBottom="20dp" />

                <!-- Save Button -->
                <Button android:id="@+id/btnSaveAppointment" android:layout_width="match_parent" android:layout_height="50dp" android:text="Save Appointment" android:textSize="16sp" android:textStyle="bold" android:textColor="@android:color/white" android:backgroundTint="#22C55E" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Saved Appointments Section -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Saved Appointments" android:textColor="#0F172A" android:textSize="18sp" android:textStyle="bold" android:layout_marginBottom="12dp" />

        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvSavedAppointments" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false" android:clipToPadding="false" android:paddingBottom="16dp" />

        <!-- Empty State -->
        <LinearLayout android:id="@+id/emptyState" android:layout_width="match_parent" android:layout_height="150dp" android:orientation="vertical" android:gravity="center" android:visibility="gone">

            <ImageView android:layout_width="60dp" android:layout_height="60dp" android:src="@drawable/ic_calendar" android:contentDescription="No appointments" android:layout_marginBottom="12dp" app:tint="#CBD5E1" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="No appointments booked yet" android:textAlignment="center" android:textColor="#64748B" android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
