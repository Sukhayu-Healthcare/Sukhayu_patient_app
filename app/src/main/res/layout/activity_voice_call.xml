<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/white">

    <!-- Header with Doctor Name and Timer -->
    <LinearLayout android:id="@+id/layoutHeader" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp" android:layout_alignParentTop="true">

        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_call" android:tint="#000000" android:layout_marginEnd="12dp"/>

        <TextView android:id="@+id/tvDoctorName" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Dr. अमित कुमार" android:textColor="#000000" android:textSize="18sp" android:textStyle="bold"/>

        <TextView android:id="@+id/tvTimer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0:25" android:textColor="#666666" android:textSize="16sp"/>

    </LinearLayout>

    <!-- Call Content Card -->
    <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_below="@id/layoutHeader" android:layout_centerInParent="true" android:layout_margin="16dp" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:cardBackgroundColor="#E8F0FE">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="48dp">

            <!-- Phone Icon Circle -->
            <androidx.cardview.widget.CardView android:layout_width="120dp" android:layout_height="120dp" app:cardCornerRadius="60dp" app:cardElevation="4dp" app:cardBackgroundColor="#1976D2" android:layout_marginBottom="24dp">

                <ImageView android:layout_width="60dp" android:layout_height="60dp" android:layout_gravity="center" android:src="@drawable/ic_call" android:tint="@android:color/white"/>

            </androidx.cardview.widget.CardView>

            <!-- Doctor Name -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dr. अमित कुमार" android:textColor="#000000" android:textSize="22sp" android:textStyle="bold" android:layout_marginBottom="8dp"/>

            <!-- Call Status -->
            <TextView android:id="@+id/tvCallStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Voice call in progress" android:textColor="#666666" android:textSize="16sp" android:layout_marginBottom="32dp"/>

            <!-- Action Buttons Row -->
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center">

                <!-- Turn on Video Button -->
                <Button android:id="@+id/btnTurnOnVideo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Turn on Video" android:textColor="#000000" android:textAllCaps="false" android:drawableStart="@drawable/ic_videocam" android:drawablePadding="8dp" android:background="@drawable/button_white_rounded" android:paddingHorizontal="24dp" android:paddingVertical="12dp" android:layout_marginEnd="12dp"/>

                <!-- Chat Button -->
                <Button android:id="@+id/btnChat" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Chat" android:textColor="#000000" android:textAllCaps="false" android:drawableStart="@drawable/ic_chat" android:drawablePadding="8dp" android:background="@drawable/button_white_rounded" android:paddingHorizontal="24dp" android:paddingVertical="12dp"/>

            </LinearLayout>

            <!-- End Call Button -->
            <androidx.cardview.widget.CardView android:layout_width="80dp" android:layout_height="80dp" app:cardCornerRadius="40dp" app:cardElevation="4dp" app:cardBackgroundColor="#D32F2F" android:layout_marginTop="32dp">

                <ImageButton android:id="@+id/btnEndCall" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/ic_call_end" android:background="?attr/selectableItemBackgroundBorderless" android:scaleType="center" android:tint="@android:color/white"/>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- Bottom Text -->
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentBottom="true" android:layout_centerHorizontal="true" android:layout_marginBottom="32dp" android:text="Waiting for doctor to end consultation" android:textColor="#666666" android:textSize="14sp"/>

</RelativeLayout>
