<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#ECE5DD">

    <!-- Header -->
    <LinearLayout android:id="@+id/headerLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_alignParentTop="true" android:orientation="horizontal" android:gravity="center_vertical" android:background="#00796B" android:padding="8dp" android:elevation="4dp">

        <ImageButton android:id="@+id/btnBack" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_arrow_back_24" android:background="?attr/selectableItemBackgroundBorderless" android:tint="@android:color/white"/>

        <androidx.cardview.widget.CardView android:layout_width="40dp" android:layout_height="40dp" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:cardBackgroundColor="@android:color/white" android:layout_marginStart="8dp">

            <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="Dr" android:textColor="#00796B" android:textSize="16sp" android:textStyle="bold" android:gravity="center"/>

        </androidx.cardview.widget.CardView>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">

            <TextView android:id="@+id/tvDoctorName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dr. अमित कुमार" android:textColor="@android:color/white" android:textSize="18sp" android:textStyle="bold"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="online" android:textColor="#B2DFDB" android:textSize="14sp"/>

        </LinearLayout>

        <ImageButton android:id="@+id/btnVoiceCall" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_call" android:background="?attr/selectableItemBackgroundBorderless" android:tint="@android:color/white" android:layout_marginEnd="4dp"/>

        <ImageButton android:id="@+id/btnVideoCall" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_videocam" android:background="?attr/selectableItemBackgroundBorderless" android:tint="@android:color/white" android:layout_marginEnd="4dp"/>

        <ImageButton android:id="@+id/btnMore" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_more_vert" android:background="?attr/selectableItemBackgroundBorderless" android:tint="@android:color/white"/>

    </LinearLayout>

    <!-- Chat Text Area (for legacy code compatibility) -->
    <TextView android:id="@+id/chatText" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_below="@id/headerLayout" android:layout_above="@id/inputContainer" android:background="#ECE5DD" android:padding="8dp" android:text="" android:textSize="16sp" android:textColor="#000000" android:gravity="top" android:scrollbars="vertical" android:visibility="gone"/>

    <!-- Messages ScrollView -->
    <ScrollView android:id="@+id/scrollViewMessages" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_below="@id/headerLayout" android:layout_above="@id/inputContainer" android:padding="8dp">

        <LinearLayout android:id="@+id/messagesContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

            <!-- Doctor Message 1 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="start" android:paddingVertical="4dp" android:paddingEnd="64dp">

                <androidx.cardview.widget.CardView android:layout_width="wrap_content" android:layout_height="wrap_content" app:cardCornerRadius="8dp" app:cardElevation="1dp" app:cardBackgroundColor="@android:color/white">

                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hello! I am Dr. Kumar. How can I help you today?" android:textColor="#000000" android:textSize="16sp"/>

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="10:30 AM" android:textColor="#999999" android:textSize="12sp" android:layout_marginTop="4dp" android:layout_gravity="end"/>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- Patient Message 1 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="end" android:paddingVertical="4dp" android:paddingStart="64dp">

                <androidx.cardview.widget.CardView android:layout_width="wrap_content" android:layout_height="wrap_content" app:cardCornerRadius="8dp" app:cardElevation="1dp" app:cardBackgroundColor="#DCF8C6">

                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="I am experiencing chest pain and difficulty breathing." android:textColor="#000000" android:textSize="16sp"/>

                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="4dp" android:layout_gravity="end">

                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="10:32 AM" android:textColor="#6B9B64" android:textSize="12sp" android:layout_marginEnd="4dp"/>

                            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_check_double" android:tint="#4FC3F7"/>

                        </LinearLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- Doctor Message 2 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="start" android:paddingVertical="4dp" android:paddingEnd="64dp">

                <androidx.cardview.widget.CardView android:layout_width="wrap_content" android:layout_height="wrap_content" app:cardCornerRadius="8dp" app:cardElevation="1dp" app:cardBackgroundColor="@android:color/white">

                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="I understand. Please stay calm. When did this pain start? Is it sharp or dull?" android:textColor="#000000" android:textSize="16sp"/>

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="10:33 AM" android:textColor="#999999" android:textSize="12sp" android:layout_marginTop="4dp" android:layout_gravity="end"/>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- Patient Message 2 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="end" android:paddingVertical="4dp" android:paddingStart="64dp">

                <androidx.cardview.widget.CardView android:layout_width="wrap_content" android:layout_height="wrap_content" app:cardCornerRadius="8dp" app:cardElevation="1dp" app:cardBackgroundColor="#DCF8C6">

                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Started about 20 minutes ago. The pain is sharp and feels like pressure." android:textColor="#000000" android:textSize="16sp"/>

                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="4dp" android:layout_gravity="end">

                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="10:34 AM" android:textColor="#6B9B64" android:textSize="12sp" android:layout_marginEnd="4dp"/>

                            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_check_double" android:tint="#4FC3F7"/>

                        </LinearLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- Doctor Warning Message -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="start" android:paddingVertical="4dp" android:paddingEnd="64dp">

                <androidx.cardview.widget.CardView android:layout_width="wrap_content" android:layout_height="wrap_content" app:cardCornerRadius="8dp" app:cardElevation="1dp" app:cardBackgroundColor="@android:color/white">

                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⚠️ This could be serious. Please sit down immediately and try to breathe deeply. I want to see you on video call right away." android:textColor="#000000" android:textSize="16sp"/>

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="10:35 AM" android:textColor="#999999" android:textSize="12sp" android:layout_marginTop="4dp" android:layout_gravity="end"/>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Input Container -->
    <LinearLayout android:id="@+id/inputContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_alignParentBottom="true" android:orientation="horizontal" android:gravity="center_vertical" android:background="#F0F0F0" android:padding="8dp">

        <ImageButton android:id="@+id/btnEmoji" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_emoji" android:background="?attr/selectableItemBackgroundBorderless" android:tint="#7C7C7C"/>

        <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:cardBackgroundColor="@android:color/white" android:layout_marginHorizontal="8dp">

            <EditText android:id="@+id/etMessage" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Type a message" android:textColorHint="#7C7C7C" android:textColor="#000000" android:textSize="16sp" android:background="@null" android:paddingHorizontal="16dp" android:paddingVertical="10dp" android:maxLines="4" android:inputType="textMultiLine|textCapSentences"/>

        </androidx.cardview.widget.CardView>

        <ImageButton android:id="@+id/btnAttach" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_attach" android:background="?attr/selectableItemBackgroundBorderless" android:tint="#7C7C7C" android:rotation="45" android:layout_marginEnd="4dp"/>

        <ImageButton android:id="@+id/btnCamera" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_camera" android:background="?attr/selectableItemBackgroundBorderless" android:tint="#7C7C7C" android:layout_marginEnd="4dp"/>

        <androidx.cardview.widget.CardView android:layout_width="48dp" android:layout_height="48dp" app:cardCornerRadius="24dp" app:cardElevation="2dp" app:cardBackgroundColor="#00796B">

            <ImageButton android:id="@+id/btnSend" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/ic_mic" android:background="?attr/selectableItemBackgroundBorderless" android:tint="@android:color/white"/>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</RelativeLayout>
