<?xml version="1.0" encoding="utf-8"?>
<!-- filepath: c:\Users\anike\Downloads\Sukhayu_patient_app\app\src\main\res\layout\ai_analysis.xml -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F5F5F5">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

        <!-- Condition Assessment Card -->
        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" app:cardCornerRadius="8dp" app:cardElevation="2dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

                <TextView android:id="@+id/tvConditionLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Condition Assessment" android:textSize="18sp" android:textStyle="bold" android:textColor="#000000" android:layout_marginBottom="8dp"/>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E0E0E0" android:layout_marginBottom="12dp"/>

                <TextView android:id="@+id/tvDiagnosis" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Viral Infection / Common Fever" android:textSize="16sp" android:textColor="#333333"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Severity Level Card -->
        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" app:cardCornerRadius="8dp" app:cardElevation="2dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

                <TextView android:id="@+id/tvSeverityLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Severity Zone" android:textSize="18sp" android:textStyle="bold" android:textColor="#000000" android:layout_marginBottom="8dp"/>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E0E0E0" android:layout_marginBottom="12dp"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">

                    <View android:layout_width="24dp" android:layout_height="24dp" android:background="@drawable/circle_yellow" android:layout_marginEnd="12dp"/>

                    <TextView android:id="@+id/tvSeverityZone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Yellow Zone" android:textSize="16sp" android:textStyle="bold" android:textColor="#FFA500"/>

                </LinearLayout>

                <TextView android:id="@+id/tvRecommendedAction" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Moderate medical attention\nSee Chief Health Officer within 2-3 days" android:textSize="14sp" android:textColor="#666666" android:lineSpacingExtra="4dp"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Recommended Doctor Card -->
        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" app:cardCornerRadius="8dp" app:cardElevation="2dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

                <TextView android:id="@+id/tvDoctorLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Recommended Doctor" android:textSize="18sp" android:textStyle="bold" android:textColor="#000000" android:layout_marginBottom="8dp"/>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E0E0E0" android:layout_marginBottom="12dp"/>

                <TextView android:id="@+id/tvDoctorType" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Chief Health Officer (CHO)" android:textSize="16sp" android:textStyle="bold" android:textColor="#333333" android:layout_marginBottom="8dp"/>

                <TextView android:id="@+id/tvDoctorNote" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Chief Health Officer assigned for Yellow/Green Zone cases" android:textSize="14sp" android:textColor="#666666"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- AI Recommendations Card -->
        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" app:cardCornerRadius="8dp" app:cardElevation="2dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

                <TextView android:id="@+id/tvRecommendationsLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AI Recommendations" android:textSize="18sp" android:textStyle="bold" android:textColor="#000000" android:layout_marginBottom="8dp"/>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E0E0E0" android:layout_marginBottom="12dp"/>

                <TextView android:id="@+id/tvRecommendation1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="• Get adequate rest" android:textSize="14sp" android:textColor="#333333" android:layout_marginBottom="8dp"/>

                <TextView android:id="@+id/tvRecommendation2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="• Increase fluid intake" android:textSize="14sp" android:textColor="#333333" android:layout_marginBottom="8dp"/>

                <TextView android:id="@+id/tvRecommendation3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="• Maintain hygiene" android:textSize="14sp" android:textColor="#333333"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Consultation Note -->
        <TextView android:id="@+id/tvConsultationNote" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Based on AI analysis, we recommend consultation with the following doctor." android:textSize="14sp" android:textColor="#666666" android:textAlignment="center" android:padding="12dp" android:layout_marginBottom="16dp"/>

        <!-- Action Button -->
        <Button android:id="@+id/btnStartConsultation" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Start Consultation with Chief Health Officer (CHO)" android:textAllCaps="false" android:textSize="16sp" android:padding="16dp" android:backgroundTint="#4CAF50"/>

    </LinearLayout>

</ScrollView>