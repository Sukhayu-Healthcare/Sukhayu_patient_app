<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="#10B981">

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_arrow_back_24"
            android:contentDescription="Back"
            android:tint="#FFFFFF" />

        <TextView
            android:id="@+id/tvHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AI Symptom Checker"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginStart="12dp" />
    </LinearLayout>

    <!-- Scrollable chat area -->
    <ScrollView
        android:id="@+id/scrollArea"
        android:layout_below="@id/header"
        android:layout_above="@+id/bottomInputBox"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="8dp">

        <LinearLayout
            android:id="@+id/chatContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvResult"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_bot_message"
                android:text="Hello! I'm your AI assistant."
                android:textColor="#1E293B"
                android:padding="12dp"
                android:textSize="15sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvUserMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_user_message"
                android:text="I have a headache."
                android:textColor="#FFFFFF"
                android:padding="12dp"
                android:textSize="15sp"
                android:layout_gravity="end"
                android:layout_marginBottom="8dp" />
        </LinearLayout>
    </ScrollView>

    <!-- Bottom input area -->
    <LinearLayout
        android:id="@+id/bottomInputBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="@drawable/rounded_big_card">

        <!-- Main complaint input -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/etComplaint"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="50dp"
                android:hint="Type your message..."
                android:background="@drawable/input_field_bg"
                android:padding="12dp"
                android:textColor="#000"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/btnSend"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_send"
                android:background="@drawable/send_button_bg"
                android:padding="12dp" />
        </LinearLayout>

        <!-- Follow-up input -->
        <LinearLayout
            android:id="@+id/followupContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/etFollowupAnswer"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="50dp"
                android:hint="Answer follow-up question..."
                android:background="@drawable/input_field_bg"
                android:padding="12dp"
                android:textColor="#000"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnSendFollowup"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:text="Send" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
