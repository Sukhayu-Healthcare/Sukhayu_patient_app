<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp">

    <TextView android:id="@+id/textViewSupervisorTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Supervisor Portal" android:textSize="20sp" android:textStyle="bold" android:layout_marginBottom="16dp" />

    <Button android:id="@+id/btnViewSurveys" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="View Surveys" android:layout_marginBottom="8dp" />

    <Button android:id="@+id/btnViewDrives" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="View Drives" android:layout_marginBottom="8dp" />

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerViewSupervisor" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="16dp" />

</LinearLayout>
