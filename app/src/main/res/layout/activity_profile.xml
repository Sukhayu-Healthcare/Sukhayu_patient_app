<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/scroll_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F9F9FB" android:padding="16dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal">

        <!-- Top bar -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:background="@android:color/white" android:elevation="2dp" android:layout_marginBottom="20dp">

            <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/asha_jyoti_logo" android:contentDescription="@string/app_name" android:layout_marginEnd="12dp" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sukhayu" android:textColor="#0F172A" android:textSize="20sp" android:textStyle="bold" />

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end|center_vertical">

                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_language" app:tint="#0F172A" android:layout_marginEnd="6dp" android:contentDescription="@string/language_icon_desc" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="English" android:textSize="14sp" android:textColor="#0F172A" />
            </LinearLayout>
        </LinearLayout>

        <!-- Profile Card -->
        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="12dp" app:cardElevation="6dp" android:layout_marginTop="4dp">

            <LinearLayout android:id="@+id/card_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal" android:padding="20dp">

                <!-- Profile Image -->
                <FrameLayout android:layout_width="110dp" android:layout_height="110dp" android:layout_marginTop="8dp" android:layout_marginBottom="16dp">

                    <ImageView android:id="@+id/profile_image" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/sample_patient" android:scaleType="centerCrop" android:contentDescription="Profile Picture" />

                    <ImageButton android:id="@+id/btn_change_image" android:layout_width="36dp" android:layout_height="36dp" android:layout_gravity="bottom|end" android:layout_margin="6dp" android:src="@android:drawable/ic_menu_camera" android:scaleType="centerInside" android:padding="6dp" app:tint="@android:color/white" android:contentDescription="Take Profile Picture" />
                </FrameLayout>

                <TextView android:id="@+id/title_profile" android:text="Profile" android:textSize="20sp" android:textColor="#000000" android:textStyle="bold" android:layout_marginBottom="20dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />

                <!-- Form fields container with proper spacing -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="4dp" android:paddingEnd="4dp">

                    <!-- Full Name Field -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="16dp">

                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Full Name" android:textColor="#000000" android:textSize="14sp" android:textStyle="bold" android:labelFor="@id/et_name" android:layout_marginBottom="8dp" />

                        <EditText android:id="@+id/et_name" android:layout_width="match_parent" android:layout_height="45dp" android:hint="राम शर्मा" android:enabled="false" android:background="@drawable/bg_edittext_rounded" android:paddingStart="14dp" android:paddingEnd="14dp" android:inputType="textPersonName" android:textSize="15sp" />
                    </LinearLayout>

                    <!-- Age Field -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="16dp">

                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Age" android:textColor="#000000" android:textSize="14sp" android:textStyle="bold" android:labelFor="@id/et_age" android:layout_marginBottom="8dp" />

                        <EditText android:id="@+id/et_age" android:layout_width="match_parent" android:layout_height="45dp" android:hint="45" android:enabled="false" android:background="@drawable/bg_edittext_rounded" android:paddingStart="14dp" android:paddingEnd="14dp" android:inputType="number" android:maxLength="3" android:textSize="15sp" />
                    </LinearLayout>

                    <!-- Gender Field -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="16dp">

                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Gender" android:textColor="#000000" android:textSize="14sp" android:textStyle="bold" android:labelFor="@id/spinner_gender" android:layout_marginBottom="8dp" />

                        <Spinner android:id="@+id/spinner_gender" android:layout_width="match_parent" android:layout_height="45dp" android:enabled="false" android:background="@drawable/bg_edittext_rounded" android:paddingStart="10dp" android:paddingEnd="10dp" />
                    </LinearLayout>

                    <!-- Phone Number Field -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="16dp">

                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Phone Number" android:textColor="#000000" android:textSize="14sp" android:textStyle="bold" android:labelFor="@id/et_phone" android:layout_marginBottom="8dp" />

                        <EditText android:id="@+id/et_phone" android:layout_width="match_parent" android:layout_height="45dp" android:hint="9876543210" android:enabled="false" android:background="@drawable/bg_edittext_rounded" android:paddingStart="14dp" android:paddingEnd="14dp" android:inputType="number" android:maxLength="15" android:importantForAutofill="no" android:textSize="15sp" />
                    </LinearLayout>

                    <!-- Patient ID Field (read-only) -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="24dp">

                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Patient ID" android:textColor="#000000" android:textSize="14sp" android:textStyle="bold" android:labelFor="@id/et_patient_id" android:layout_marginBottom="8dp" />

                        <EditText android:id="@+id/et_patient_id" android:layout_width="match_parent" android:layout_height="45dp" android:hint="P001" android:enabled="false" android:background="@drawable/bg_edittext_rounded" android:paddingStart="14dp" android:paddingEnd="14dp" android:inputType="text" android:focusable="false" android:textSize="15sp" />
                    </LinearLayout>

                </LinearLayout>

                <!-- Buttons Container -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="4dp" android:paddingEnd="4dp">

                    <Button android:id="@+id/btn_edit" android:layout_width="match_parent" android:layout_height="45dp" android:text="Edit" android:textSize="16sp" android:textStyle="bold" android:backgroundTint="#22C55E" android:textColor="@android:color/black" android:layout_marginBottom="12dp" />

                    <Button android:id="@+id/btn_logout" android:layout_width="match_parent" android:layout_height="45dp" android:text="Logout" android:textSize="16sp" android:textStyle="bold" android:backgroundTint="#DC2626" android:textColor="@android:color/black" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>