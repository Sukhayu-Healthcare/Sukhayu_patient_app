<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9F9FB"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <include
            android:id="@+id/header"
            layout="@layout/include_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:id="@+id/card_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="20dp">

                <!-- Profile Image -->
                <FrameLayout
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:id="@+id/profile_image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/sample_patient"
                        android:scaleType="centerCrop"
                        android:contentDescription="@string/profile_picture_desc" />

                    <ImageButton
                        android:id="@+id/btn_change_image"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="6dp"
                        android:src="@android:drawable/ic_menu_camera"
                        android:scaleType="centerInside"
                        android:padding="6dp"
                        app:tint="@android:color/white"
                        android:contentDescription="@string/take_profile_picture" />
                </FrameLayout>

                <TextView
                    android:id="@+id/title_profile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile"
                    android:textSize="20sp"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    android:layout_marginBottom="20dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp">

                    <!-- Full Name -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/full_name"
                            android:textColor="#000000"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:labelFor="@id/et_name"
                            android:layout_marginBottom="8dp" />

                        <EditText
                            android:id="@+id/et_name"
                            android:layout_width="match_parent"
                            android:layout_height="45dp"
                            android:hint="@string/full_name_hint"
                            android:enabled="false"
                            android:background="@drawable/bg_edittext_rounded"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:inputType="textPersonName"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <!-- Age -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/age"
                            android:textColor="#000000"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:labelFor="@id/et_age"
                            android:layout_marginBottom="8dp" />

                        <EditText
                            android:id="@+id/et_age"
                            android:layout_width="match_parent"
                            android:layout_height="45dp"
                            android:hint="@string/age_hint"
                            android:enabled="false"
                            android:background="@drawable/bg_edittext_rounded"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:inputType="number"
                            android:maxLength="3"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <!-- Gender -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/gender"
                            android:textColor="#000000"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:labelFor="@id/spinner_gender"
                            android:layout_marginBottom="8dp" />

                        <Spinner
                            android:id="@+id/spinner_gender"
                            android:layout_width="match_parent"
                            android:layout_height="45dp"
                            android:enabled="false"
                            android:background="@drawable/bg_edittext_rounded"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp" />
                    </LinearLayout>

                    <!-- Phone -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/phone_number"
                            android:textColor="#000000"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:labelFor="@id/et_phone"
                            android:layout_marginBottom="8dp" />

                        <EditText
                            android:id="@+id/et_phone"
                            android:layout_width="match_parent"
                            android:layout_height="45dp"
                            android:hint="@string/phone_number_hint"
                            android:enabled="false"
                            android:background="@drawable/bg_edittext_rounded"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:inputType="number"
                            android:maxLength="10"
                            android:importantForAutofill="no"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <!-- Password -->
                    <LinearLayout
                        android:id="@+id/layout_password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="16dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/password"
                            android:textColor="#000000"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp" />

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <EditText
                                android:id="@+id/et_password"
                                android:layout_width="match_parent"
                                android:layout_height="45dp"
                                android:hint="@string/password_hint"
                                android:background="@drawable/bg_edittext_rounded"
                                android:paddingStart="14dp"
                                android:paddingEnd="48dp"
                                android:inputType="textPassword"
                                android:textSize="15sp" />

                            <ImageButton
                                android:id="@+id/btn_toggle_password"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_gravity="end|center_vertical"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:src="@drawable/ic_visibility_off"
                                android:contentDescription="@string/toggle_password_visibility" />
                        </FrameLayout>
                    </LinearLayout>

                    <!-- Confirm Password -->
                    <LinearLayout
                        android:id="@+id/layout_confirm_password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="16dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/confirm_password"
                            android:textColor="#000000"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp" />

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <EditText
                                android:id="@+id/et_confirm_password"
                                android:layout_width="match_parent"
                                android:layout_height="45dp"
                                android:hint="@string/confirm_password_hint"
                                android:background="@drawable/bg_edittext_rounded"
                                android:paddingStart="14dp"
                                android:paddingEnd="48dp"
                                android:inputType="textPassword"
                                android:textSize="15sp" />

                            <ImageButton
                                android:id="@+id/btn_toggle_confirm_password"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_gravity="end|center_vertical"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:src="@drawable/ic_visibility_off"
                                android:contentDescription="@string/toggle_confirm_password_visibility" />
                        </FrameLayout>
                    </LinearLayout>

                    <!-- Patient ID -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="24dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/patient_id"
                            android:textColor="#000000"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp" />

                        <EditText
                            android:id="@+id/et_patient_id"
                            android:layout_width="match_parent"
                            android:layout_height="45dp"
                            android:hint="@string/patient_id_hint"
                            android:enabled="false"
                            android:background="@drawable/bg_edittext_rounded"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:inputType="text"
                            android:focusable="false"
                            android:textSize="15sp" />
                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp">

                    <Button
                        android:id="@+id/btn_edit"
                        android:layout_width="match_parent"
                        android:layout_height="45dp"
                        android:text="@string/edit"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:backgroundTint="#22C55E"
                        android:textColor="@android:color/black"
                        android:layout_marginBottom="12dp" />

                    <Button
                        android:id="@+id/btn_logout"
                        android:layout_width="match_parent"
                        android:layout_height="45dp"
                        android:text="@string/logout"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:backgroundTint="#DC2626"
                        android:textColor="@android:color/black" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>