<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/videoContainer" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/gradient_background_video">

    <!-- Remote Video View (Full Screen) -->
    <SurfaceView android:id="@+id/remoteView" android:layout_width="match_parent" android:layout_height="match_parent" />

    <!-- Top Header with Doctor Info -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="#DD000000" android:padding="16dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">

            <!-- Doctor Avatar -->
            <androidx.cardview.widget.CardView android:layout_width="48dp" android:layout_height="48dp" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:cardBackgroundColor="#00897B">

                <TextView android:id="@+id/tvDoctorInitial" android:layout_width="match_parent" android:layout_height="match_parent" android:text="D" android:textColor="@android:color/white" android:textSize="20sp" android:textStyle="bold" android:gravity="center"/>

                <!-- Online Indicator -->
                <View android:layout_width="12dp" android:layout_height="12dp" android:layout_gravity="bottom|end" android:layout_margin="2dp" android:background="@drawable/circle_online"/>

            </androidx.cardview.widget.CardView>

            <!-- Doctor Info -->
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">

                <TextView android:id="@+id/tvDoctorName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dr. अमित कुमार" android:textColor="@android:color/white" android:textSize="18sp" android:textStyle="bold"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Chief Health Officer" android:textColor="#B0BEC5" android:textSize="14sp"/>

            </LinearLayout>

            <!-- Timer -->
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginEnd="16dp">

                <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_timer" android:tint="#B0BEC5" android:layout_marginEnd="4dp"/>

                <TextView android:id="@+id/tvTimer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="00:03" android:textColor="@android:color/white" android:textSize="14sp"/>

            </LinearLayout>

            <!-- Signal Quality -->
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginEnd="16dp">

                <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_signal" android:tint="#FFA726" android:layout_marginEnd="4dp"/>

                <TextView android:id="@+id/tvSignalQuality" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Good" android:textColor="#FFA726" android:textSize="14sp"/>

            </LinearLayout>

            <!-- Fullscreen Button -->
            <ImageButton android:id="@+id/btnFullscreen" android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_fullscreen" android:background="?attr/selectableItemBackgroundBorderless" android:tint="@android:color/white"/>

        </LinearLayout>

        <!-- Chat Available Button -->
        <Button android:id="@+id/btnChatAvailable" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Chat available" android:textColor="@android:color/white" android:textAllCaps="false" android:drawableStart="@drawable/ic_chat_bubble" android:drawablePadding="8dp" android:background="@drawable/button_chat_available" android:paddingHorizontal="16dp" android:paddingVertical="8dp" android:layout_gravity="end" android:layout_marginTop="12dp"/>

    </LinearLayout>

    <!-- Local Video Preview (Top Right) -->
    <androidx.cardview.widget.CardView android:layout_width="140dp" android:layout_height="200dp" android:layout_gravity="top|end" android:layout_marginTop="140dp" android:layout_marginEnd="16dp" app:cardCornerRadius="12dp" app:cardElevation="8dp" app:cardBackgroundColor="#00897B">

        <SurfaceView android:id="@+id/localView" android:layout_width="match_parent" android:layout_height="match_parent" />

        <!-- Camera Icon Placeholder -->
        <ImageView android:layout_width="64dp" android:layout_height="64dp" android:layout_gravity="center" android:src="@drawable/ic_camera_large" android:tint="@android:color/white" android:alpha="0.7"/>

    </androidx.cardview.widget.CardView>

    <!-- Doctor Info Card (Center) -->
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:orientation="vertical" android:gravity="center">

        <androidx.cardview.widget.CardView android:layout_width="120dp" android:layout_height="120dp" app:cardCornerRadius="60dp" app:cardElevation="4dp" app:cardBackgroundColor="#00897B">

            <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="D" android:textColor="@android:color/white" android:textSize="48sp" android:textStyle="bold" android:gravity="center"/>

        </androidx.cardview.widget.CardView>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dr. अमित कुमार" android:textColor="@android:color/white" android:textSize="24sp" android:textStyle="bold" android:layout_marginTop="16dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Chief Health Officer" android:textColor="#B0BEC5" android:textSize="16sp" android:layout_marginTop="4dp"/>

    </LinearLayout>

    <!-- Bottom Control Panel -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:orientation="vertical" android:background="#DD000000" android:paddingVertical="24dp">

        <!-- Control Buttons -->
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:orientation="horizontal" android:gravity="center">

            <!-- Mute Button -->
            <androidx.cardview.widget.CardView android:layout_width="64dp" android:layout_height="64dp" app:cardCornerRadius="32dp" app:cardElevation="4dp" app:cardBackgroundColor="@android:color/white" android:layout_marginEnd="16dp">

                <ImageButton android:id="@+id/btnMute" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/ic_mic" android:background="?attr/selectableItemBackgroundBorderless" android:tint="#000000"/>

            </androidx.cardview.widget.CardView>

            <!-- Video Toggle Button -->
            <androidx.cardview.widget.CardView android:layout_width="64dp" android:layout_height="64dp" app:cardCornerRadius="32dp" app:cardElevation="4dp" app:cardBackgroundColor="@android:color/white" android:layout_marginEnd="16dp">

                <ImageButton android:id="@+id/btnVideoToggle" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/ic_videocam" android:background="?attr/selectableItemBackgroundBorderless" android:tint="#000000"/>

            </androidx.cardview.widget.CardView>

            <!-- End Call Button -->
            <androidx.cardview.widget.CardView android:layout_width="72dp" android:layout_height="72dp" app:cardCornerRadius="36dp" app:cardElevation="8dp" app:cardBackgroundColor="#D32F2F" android:layout_marginEnd="16dp">

                <ImageButton android:id="@+id/btnEndCall" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/ic_call_end" android:background="?attr/selectableItemBackgroundBorderless" android:tint="@android:color/white"/>

            </androidx.cardview.widget.CardView>

            <!-- Speaker Button -->
            <androidx.cardview.widget.CardView android:layout_width="64dp" android:layout_height="64dp" app:cardCornerRadius="32dp" app:cardElevation="4dp" app:cardBackgroundColor="@android:color/white" android:layout_marginEnd="16dp">

                <ImageButton android:id="@+id/btnSpeaker" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/ic_volume_up" android:background="?attr/selectableItemBackgroundBorderless" android:tint="#000000"/>

            </androidx.cardview.widget.CardView>

            <!-- Chat Button -->
            <androidx.cardview.widget.CardView android:layout_width="64dp" android:layout_height="64dp" app:cardCornerRadius="32dp" app:cardElevation="4dp" app:cardBackgroundColor="@android:color/white">

                <ImageButton android:id="@+id/btnChat" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/ic_chat" android:background="?attr/selectableItemBackgroundBorderless" android:tint="#000000"/>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- Connection Status -->
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:orientation="horizontal" android:layout_marginTop="16dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Connection issues?" android:textColor="#B0BEC5" android:textSize="14sp" android:layout_marginEnd="8dp"/>

            <TextView android:id="@+id/tvSwitchToVoice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Switch to Voice Call" android:textColor="#00BFA5" android:textSize="14sp" android:textStyle="bold"/>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
