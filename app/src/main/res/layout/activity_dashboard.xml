<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="#F8FAFC" tools:context="com.sukhayu.patient.ui.dashboard.DashboardActivity">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

        <!-- Header -->
        <include android:id="@+id/header" layout="@layout/include_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

            <!-- Profile Card -->
            <com.google.android.material.card.MaterialCardView android:id="@+id/cardProfile" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" app:cardCornerRadius="12dp" app:cardElevation="3dp" app:strokeColor="#E2E8F0" app:strokeWidth="1dp" android:backgroundTint="@android:color/white" android:clickable="true" android:focusable="true">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">

                        <ImageView android:layout_width="60dp" android:layout_height="60dp" android:src="@drawable/sample_patient" android:scaleType="centerCrop" android:contentDescription="@string/profile_icon_desc" android:layout_marginEnd="12dp" />

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">

                            <TextView android:id="@+id/tvUserName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="20sp" android:textStyle="bold" android:text="@string/profile_name_placeholder" />

                            <TextView android:id="@+id/tvUserPhone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="16sp" android:text="@string/profile_phone_placeholder" />

                        </LinearLayout>
                    </LinearLayout>

                    <!-- Logout Button -->
                    <Button android:id="@+id/btnLogout" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end" android:layout_marginTop="12dp" android:text="@string/logout" android:textColor="@android:color/white" android:backgroundTint="#DC2626" android:paddingHorizontal="16dp" android:paddingVertical="8dp" android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Dashboard Options -->
            <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="2" android:useDefaultMargins="true">

                <!-- AI Symptom Checker -->
                <com.google.android.material.card.MaterialCardView android:id="@+id/cardCheckSymptoms" android:layout_width="0dp" android:layout_height="140dp" android:layout_columnWeight="1" app:cardCornerRadius="12dp" app:cardElevation="2dp" android:backgroundTint="@android:color/white">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">

                        <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_symptom" android:contentDescription="@string/symptom_icon_desc" app:tint="#2563EB" />

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/check_symptoms" android:textSize="14sp" android:textColor="#0F172A" android:layout_marginTop="8dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Past Consultations -->
                <com.google.android.material.card.MaterialCardView android:id="@+id/cardPastConsultations" android:layout_width="0dp" android:layout_height="140dp" android:layout_columnWeight="1" app:cardCornerRadius="12dp" app:cardElevation="2dp" android:backgroundTint="@android:color/white">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">

                        <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_history" android:contentDescription="@string/past_consultations" app:tint="#7C3AED" tools:ignore="UseAppTint" />

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/past_consultations_label" android:textSize="14sp" android:textColor="#0F172A" android:layout_marginTop="8dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Disease Outbreak -->
                <com.google.android.material.card.MaterialCardView android:id="@+id/cardDiseaseOutbreak" android:layout_width="0dp" android:layout_height="140dp" android:layout_columnWeight="1" app:cardCornerRadius="12dp" app:cardElevation="2dp" android:backgroundTint="@android:color/white">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">

                        <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_health_banner" app:tint="#059669" android:contentDescription="@string/medicines" tools:ignore="UseAppTint" />

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/disease_outbreak_label" android:textSize="14sp" android:textColor="#0F172A" android:layout_marginTop="8dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Book Appointment Card (same style as other dashboard cards) -->
                <com.google.android.material.card.MaterialCardView android:id="@+id/cardBookAppointment" android:layout_width="0dp" android:layout_height="140dp" android:layout_columnWeight="1" app:cardCornerRadius="12dp" app:cardElevation="2dp" android:backgroundTint="@android:color/white">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">

                        <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_calendar" android:contentDescription="@string/desc_calendar" app:tint="@color/colorPrimary" />

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/book_appointment" android:textSize="14sp" android:textColor="#0F172A" android:layout_marginTop="8dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </GridLayout>

            <!-- Emergency Button -->
            <Button android:id="@+id/btnEmergency" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/emergency_label" android:backgroundTint="#DC2626" android:textColor="@android:color/white" android:textStyle="bold" android:paddingVertical="12dp" />

            <!-- DEBUG: Test Video Call (remove in production) -->
            <Button
                android:id="@+id/btnDebugTestVideoCall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/test_video_call"
                android:textAllCaps="false"
                android:backgroundTint="@color/colorPrimary"
                android:textColor="@android:color/white"
                android:visibility="visible"
                android:paddingVertical="12dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
