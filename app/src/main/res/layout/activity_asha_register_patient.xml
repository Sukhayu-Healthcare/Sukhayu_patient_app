<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/white">

    <!-- Header with Title and Info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@android:color/white">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Register New Patient"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@android:color/black" />

        <TextView
            android:id="@+id/tv_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Please fill details of the head of the family first."
            android:textSize="12sp"
            android:textColor="#999999"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Main scrollable content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="16dp">

            <!-- SECTION 1: PERSONAL DETAILS -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@android:color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Personal Details"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/black"
                        android:layout_marginBottom="12dp" />

                    <!-- Name Field -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Patient Name *"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/black"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/et_patient_name"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="Enter patient's full name"
                        android:inputType="text"
                        android:padding="12dp"
                        android:background="@drawable/rounded_edittext"
                        android:layout_marginBottom="12dp" />

                    <!-- Password Field -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Create Password *"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/black"
                        android:layout_marginBottom="4dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:orientation="horizontal"
                        android:background="@drawable/rounded_edittext"
                        android:layout_marginBottom="12dp">

                        <EditText
                            android:id="@+id/et_password"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:hint="Used for patient login (if needed)."
                            android:inputType="textPassword"
                            android:padding="12dp"
                            android:background="@android:color/transparent"
                            android:textSize="14sp" />

                        <ImageButton
                            android:id="@+id/btn_toggle_password"
                            android:layout_width="48dp"
                            android:layout_height="match_parent"
                            android:src="@android:drawable/ic_menu_view"
                            android:background="?attr/selectableItemBackground"
                            android:contentDescription="Toggle password visibility"
                            android:scaleType="centerInside"
                            android:padding="12dp" />
                    </LinearLayout>

                    <!-- Gender Field -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gender *"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/black"
                        android:layout_marginBottom="4dp" />

                    <Spinner
                        android:id="@+id/spinner_gender"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="12dp"
                        android:padding="12dp"
                        android:background="@drawable/rounded_edittext" />

                    <!-- Date of Birth Field -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Date of Birth *"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/black"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/et_dob"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="DD/MM/YYYY"
                        android:inputType="text"
                        android:focusable="false"
                        android:clickable="true"
                        android:padding="12dp"
                        android:background="@drawable/rounded_edittext"
                        android:layout_marginBottom="12dp" />

                    <!-- Profile Photo Button -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Profile Photo"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/black"
                        android:layout_marginBottom="4dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/iv_profile_photo"
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:scaleType="centerCrop"
                            android:background="@drawable/rounded_edittext"
                            android:contentDescription="Profile photo preview"
                            android:layout_marginEnd="12dp" />

                        <Button
                            android:id="@+id/btn_add_photo"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="Add Photo"
                            android:textSize="14sp"
                            android:textColor="@android:color/white"
                            android:background="@drawable/rounded_button_blue"
                            android:layout_marginEnd="0dp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- SECTION 2: ADDRESS DETAILS -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@android:color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Address Details"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/black"
                        android:layout_marginBottom="12dp" />

                    <!-- Phone Field -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Phone Number *"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/black"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/et_phone"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="+91-XXXXXXXXXX"
                        android:inputType="phone"
                        android:padding="12dp"
                        android:maxLength="10"
                        android:background="@drawable/rounded_edittext"
                        android:layout_marginBottom="12dp" />

                    <!-- Village Field -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Village *"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/black"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/et_village"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="Enter village name"
                        android:inputType="text"
                        android:padding="12dp"
                        android:background="@drawable/rounded_edittext"
                        android:layout_marginBottom="12dp" />

                    <!-- Taluka Field -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Taluka *"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/black"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/et_taluka"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="Enter taluka name"
                        android:inputType="text"
                        android:padding="12dp"
                        android:background="@drawable/rounded_edittext"
                        android:layout_marginBottom="12dp" />

                    <!-- District Field -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="District *"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/black"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/et_district"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="Enter district name"
                        android:inputType="text"
                        android:padding="12dp"
                        android:background="@drawable/rounded_edittext" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- SECTION 3: HEALTH & FAMILY DETAILS -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@android:color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Health &amp; Family Details"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/black"
                        android:layout_marginBottom="12dp" />

                    <!-- Supreme ID Field -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Supreme ID (Family Head)"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/black"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/et_supreme_id"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="Optional - leave empty if family head"
                        android:inputType="number"
                        android:padding="12dp"
                        android:background="@drawable/rounded_edittext"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="If this patient is the head of the family, leave this empty. System will create a Supreme ID for them. If this is a family member, enter the Supreme ID of the head."
                        android:textSize="11sp"
                        android:textColor="#666666"
                        android:layout_marginBottom="12dp" />

                    <!-- Health History Section -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Health History"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/black"
                        android:layout_marginBottom="12dp" />

                    <!-- Dynamic History Container -->
                    <LinearLayout
                        android:id="@+id/layout_history_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="12dp" />

                    <!-- Add Disease Button -->
                    <Button
                        android:id="@+id/btn_add_disease"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="+ Add Disease"
                        android:textSize="14sp"
                        android:textColor="#2196F3"
                        android:background="@drawable/rounded_button_outline"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Register Button -->
            <Button
                android:id="@+id/btn_register_patient"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Register Patient"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:background="@drawable/rounded_button_blue"
                android:layout_marginBottom="16dp" />

            <!-- Info Strip at Bottom -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#E3F2FD"
                android:padding="12dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_dialog_info"
                    android:contentDescription="Info icon"
                    android:layout_marginEnd="8dp"
                    android:tint="#2196F3"
                    tools:ignore="UseAppTint" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="After registration, a unique Patient ID will be created. Share this ID with the patient for future visits."
                    android:textSize="11sp"
                    android:textColor="#1976D2" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>

