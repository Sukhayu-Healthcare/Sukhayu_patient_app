<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/white">

    <!-- Include Header -->
    <include
        layout="@layout/include_header" />

    <!-- Search Bar -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp">

        <EditText
            android:id="@+id/etSearchAsha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Search by name, ID, or phone"
            android:padding="12dp"
            android:drawableStart="@android:drawable/ic_menu_search"
            android:drawablePadding="8dp"
            android:background="@android:color/white"
            android:inputType="text"
            android:maxLines="1" />
    </androidx.cardview.widget.CardView>

    <!-- ASHA Count -->
    <TextView
        android:id="@+id/tvAshaCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:text="Total ASHA Workers: 0"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#333333" />

    <!-- RecyclerView for ASHA list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewAsha"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp"
        android:clipToPadding="false" />

    <!-- Pagination controls -->
    <LinearLayout
        android:id="@+id/paginationContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center">

        <Button
            android:id="@+id/btnPrevPage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Previous"
            android:enabled="false" />

        <TextView
            android:id="@+id/tvPageInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:text="Page 1 of 1"
            android:textSize="14sp"
            android:textColor="#333333" />

        <Button
            android:id="@+id/btnNextPage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Next"
            android:enabled="false" />
    </LinearLayout>

</LinearLayout>
