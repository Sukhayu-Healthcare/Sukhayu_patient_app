<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

    <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="ASHA Name">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etEditAshaName" android:layout_width="match_parent" android:layout_height="wrap_content" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="State" android:textSize="12sp" android:textColor="#666666" android:layout_marginTop="16dp" android:layout_marginBottom="4dp" android:paddingStart="4dp" android:paddingEnd="4dp" />

    <EditText android:id="@+id/etEditState" android:layout_width="match_parent" android:layout_height="48dp" android:text="Maharashtra" android:inputType="none" android:focusable="false" android:padding="12dp" android:background="@android:color/white" android:textColor="#666666" />

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="District" android:textSize="12sp" android:textColor="#666666" android:layout_marginTop="16dp" android:layout_marginBottom="4dp" android:paddingStart="4dp" android:paddingEnd="4dp" />

    <Spinner android:id="@+id/spinnerEditDistrict" android:layout_width="match_parent" android:layout_height="48dp" android:padding="12dp" android:background="@android:color/white" />

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Taluka" android:textSize="12sp" android:textColor="#666666" android:layout_marginTop="16dp" android:layout_marginBottom="4dp" android:paddingStart="4dp" android:paddingEnd="4dp" />

    <Spinner android:id="@+id/spinnerEditTaluka" android:layout_width="match_parent" android:layout_height="48dp" android:padding="12dp" android:background="@android:color/white" />

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Village" android:textSize="12sp" android:textColor="#666666" android:layout_marginTop="16dp" android:layout_marginBottom="4dp" android:paddingStart="4dp" android:paddingEnd="4dp" />

    <Spinner android:id="@+id/spinnerEditVillage" android:layout_width="match_parent" android:layout_height="48dp" android:padding="12dp" android:background="@android:color/white" />

</LinearLayout>
