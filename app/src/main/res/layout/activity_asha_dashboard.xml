<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#F8FAFC">

    <!-- Include Common Header -->
    <include layout="@layout/include_header" />

    <ScrollView android:id="@+id/asha_dashboard_scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

            <!-- Profile Card -->
            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="12dp" app:cardElevation="2dp" android:layout_marginBottom="16dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">

                        <!-- Profile Photo -->
                        <ImageView android:id="@+id/ivProfilePhoto" android:layout_width="60dp" android:layout_height="60dp" android:src="@drawable/ic_person_outline" android:background="@drawable/rounded_card_bg" android:padding="12dp" android:contentDescription="Profile Photo" />

                        <!-- Profile Details -->
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="16dp">

                            <TextView android:id="@+id/tv_asha_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/sample_asha_name" android:textSize="1sp" android:textStyle="bold" android:textColor="#0F172A" />

                            <TextView android:id="@+id/tvAshaId" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ID: A001" android:textSize="15sp" android:textColor="#0F172A" android:layout_marginTop="2dp" />

                            <TextView android:id="@+id/tv_asha_village" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Village: -" android:textSize="15sp" android:textColor="#0F172A" android:layout_marginTop="2dp" />

                            <TextView android:id="@+id/tv_asha_taluka" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Taluka: -" android:textSize="15sp" android:textColor="#0F172A" android:layout_marginTop="2dp" />

                            <TextView android:id="@+id/tv_asha_district" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="District: -" android:textSize="15sp" android:textColor="#0F172A" android:layout_marginTop="2dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Logout Button and Warning -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="12dp" android:gravity="center">

                        <Button
                            android:id="@+id/tv_logout"
                            android:layout_width="120dp"
                            android:layout_height="36dp"
                            android:backgroundTint="@color/asha_red"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:text="Logout"
                            android:textColor="@android:color/white"
                            android:textSize="12sp" />

                        <TextView android:id="@+id/tv_logout_warning" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Note: Logging out needs internet to reload your data." android:textSize="11sp" android:textColor="#B91C1C" android:textStyle="italic" android:layout_marginTop="6dp" android:gravity="center" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Dashboard Title -->
            <TextView android:id="@+id/tv_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/asha_dashboard_title" android:textColor="#0F172A" android:textSize="22sp" android:textStyle="bold" android:layout_marginBottom="16dp" />

            <!-- 2x2 metrics grid -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

                <!-- Row 1 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="12dp" android:weightSum="2">

                    <!-- Metric card - Blue -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardTotalPatients"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="120dp"
                        android:layout_marginEnd="8dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="2dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground">

                        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#E3F2FD" android:padding="14dp" android:gravity="center">

                            <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_person_outline" app:tint="#1976D2" android:contentDescription="@string/desc_total_patients" />


                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Total Patients" android:textSize="16sp" android:textColor="#424242" android:layout_marginTop="4dp" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Metric card - Green -->
                    <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_weight="1" android:layout_height="120dp" android:layout_marginStart="8dp" app:cardCornerRadius="12dp" app:cardElevation="2dp">

                        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#E8F5E9" android:padding="14dp" android:gravity="center">

                            <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_trending_up" app:tint="#388E3C" android:contentDescription="@string/desc_active_cases" />



                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Active Cases" android:textSize="16sp" android:textColor="#424242" android:layout_marginTop="4dp" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <!-- Row 2 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="2">

                    <!-- Metric card - Purple -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardCompletedToday"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="120dp"
                        android:layout_marginEnd="8dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="2dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground">

                        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#F3E5F5" android:padding="14dp" android:gravity="center">

                            <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_calendar" app:tint="#7B1FA2" android:contentDescription="@string/desc_my_schedule" />



                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="My Schedule" android:textSize="16sp" android:textColor="#424242" android:layout_marginTop="4dp" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Metric card - Red -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardEmergency"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="120dp"
                        android:layout_marginStart="8dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="2dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground">

                        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#FFEBEE" android:padding="14dp" android:gravity="center">

                            <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_warning" app:tint="#C62828" android:contentDescription="@string/desc_emergency_cases" />



                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Emergency" android:textSize="16sp" android:textColor="#424242" android:layout_marginTop="4dp" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>
            </LinearLayout>

            <!-- Quick Actions -->
            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="12dp" app:cardElevation="2dp" android:layout_marginTop="18dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Quick Actions" android:textSize="18sp" android:textStyle="bold" android:textColor="#0F172A" />

                    <!-- Buttons with proper colors -->
                    <Button
                        android:id="@+id/btn_register_patient"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="8dp"
                        android:backgroundTint="#388E3C"
                        android:drawableLeft="@drawable/ic_person_add"
                        android:drawablePadding="12dp"
                        android:text="@string/action_register_patient"
                        android:textColor="@android:color/white"
                        app:cornerRadius="8dp" />

                    <Button
                        android:id="@+id/btnSurveys"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="8dp"
                        android:backgroundTint="#0288D1"
                        android:drawableLeft="@drawable/ic_document"
                        android:drawablePadding="12dp"
                        android:text="Conduct Survey"
                        android:textColor="@android:color/white"
                        app:cornerRadius="8dp" />

                    <Button android:id="@+id/btn_view_surveys" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp" android:backgroundTint="#1976D2" android:text="@string/action_view_surveys" android:textColor="@android:color/white" android:drawableLeft="@drawable/ic_person_outline" android:drawablePadding="12dp" app:cornerRadius="8dp" />

                    <Button android:id="@+id/btn_health_drives" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:backgroundTint="#00897B" android:text="@string/action_health_drives" android:textColor="@android:color/white" android:drawableLeft="@drawable/ic_send" android:drawablePadding="12dp" app:cornerRadius="8dp" />


                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Patient Services card (small grid) -->
            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="12dp" android:layout_marginTop="16dp" app:cardElevation="0dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">

                    <!-- Patient Services title -->
                    <TextView android:text="Patient Services" android:textStyle="bold" android:textSize="16sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">

                        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="72dp" android:orientation="vertical" android:background="@drawable/program_item_bg" android:gravity="center" android:layout_marginEnd="8dp">
                            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_robot" android:contentDescription="@string/desc_patient_services"/>
                            <TextView android:text="Patient Services" android:textStyle="bold" android:textSize="16sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp"/>

                        </LinearLayout>

                        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="72dp" android:orientation="vertical" android:background="@drawable/program_item_bg" android:gravity="center" android:layout_marginStart="8dp">
                            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_stethoscope" android:contentDescription="@string/desc_consult_doctor"/>
                            <TextView android:text="Consult Doctor" android:textSize="13sp" android:textColor="@color/muted_text" android:layout_marginTop="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- second row -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp">
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="72dp" android:orientation="vertical" android:background="@drawable/program_item_bg" android:gravity="center" android:layout_marginEnd="8dp">
                            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_document" android:contentDescription="@string/desc_past_consultations"/>
                            <TextView android:text="Past Consultations" android:textSize="13sp" android:textColor="@color/muted_text" android:layout_marginTop="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>

                        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="72dp" android:orientation="vertical" android:background="@drawable/program_item_bg" android:gravity="center" android:layout_marginStart="8dp">
                            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_analytics" android:contentDescription="@string/desc_disease_analytics"/>
                            <TextView android:text="Disease Analytics" android:textSize="13sp" android:textColor="@color/muted_text" android:layout_marginTop="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>
                    </LinearLayout>


                </LinearLayout>
            </androidx.cardview.widget.CardView>



            <!-- Recent Activity (simple mock) -->
            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" app:cardCornerRadius="12dp" app:cardElevation="2dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                    <TextView android:text="Recent Activity" android:textSize="16sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="12dp">
                        <TextView android:text="• Patient registered — राम शर्मा • 2 hours ago" android:textColor="@color/muted_text" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:layout_marginTop="8dp" android:text="• Consultation completed — सीता देवी • 5 hours ago" android:textColor="@color/muted_text" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:layout_marginTop="8dp" android:text="• Emergency case referred — मोहन गुप्ता • 1 day ago" android:textColor="@color/muted_text" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- National Health Programs hero -->
            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" app:cardCornerRadius="12dp" app:cardElevation="0dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_gradient_programs" android:padding="16dp">
                    <TextView android:text="National Health Programs" android:textSize="16sp" android:textStyle="bold" android:textColor="@android:color/white" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:text="Major health schemes by Government of India" android:layout_marginTop="6dp" android:textColor="@android:color/white" android:textSize="13sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <Button android:id="@+id/btn_view_programs" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginTop="12dp" android:background="@drawable/program_item_bg" android:text="View All Programs"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>



            <!-- Community Health Tips -->
            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" app:cardCornerRadius="12dp" app:cardElevation="2dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                    <TextView android:text="Community Health Tips" android:textSize="16sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="12dp">
                        <TextView android:background="@drawable/tip_blue_bg" android:padding="10dp" android:text="Monsoon Health\nEnsure clean drinking water and prevent waterborne diseases." android:textColor="@color/muted_text" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                        <TextView android:layout_marginTop="8dp" android:background="@drawable/tip_blue_bg" android:padding="10dp" android:text="Vaccination Drive\nRemind families about upcoming vaccination schedules." android:textColor="@color/muted_text" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                        <TextView android:layout_marginTop="8dp" android:background="@drawable/tip_blue_bg" android:padding="10dp" android:text="Diabetes Awareness\nRegular screening for diabetes in adults above 30 years." android:textColor="@color/muted_text" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Hidden placeholders so code that looks up these IDs doesn't crash -->
            <Button android:id="@+id/btn_open_maternal" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>

            <Button android:id="@+id/btn_open_vaccination" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>

            <View android:layout_width="match_parent" android:layout_height="18dp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
