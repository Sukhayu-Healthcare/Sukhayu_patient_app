<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/asha_dashboard_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header row: title + asha name + language + logout -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/asha_dashboard_title"
                    android:textColor="#1F1F1F"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tv_asha_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sample_asha_name"
                    android:textSize="13sp"
                    android:textColor="@color/muted_text"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <ImageView
                android:id="@+id/iv_language"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/rounded_card_bg"
                android:padding="6dp"
                android:src="@drawable/ic_language"
                android:contentDescription="@string/language_icon_desc"/>

            <TextView
                android:id="@+id/tv_logout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Logout"
                android:textColor="@color/asha_red"
                android:textSize="14sp"
                android:paddingStart="8dp"
                android:paddingEnd="4dp"/>
        </LinearLayout>

        <!-- 2x2 metrics grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Row 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp"
                android:weightSum="2">

                <!-- Metric card -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="120dp"
                    android:orientation="vertical"
                    android:background="@drawable/rounded_card_bg"
                    android:padding="14dp"
                    android:layout_marginEnd="8dp"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_person_outline"
                        android:contentDescription="@string/desc_total_patients" />

                    <TextView
                        android:id="@+id/tv_total_patients"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="12"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:layout_marginTop="6dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total Patients"
                        android:textSize="13sp"
                        android:textColor="@color/muted_text"
                        android:layout_marginTop="6dp"/>
                </LinearLayout>

                <!-- Metric card -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="120dp"
                    android:orientation="vertical"
                    android:background="@drawable/rounded_card_bg"
                    android:padding="14dp"
                    android:layout_marginStart="8dp"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_trending_up"
                        android:contentDescription="@string/desc_active_cases" />

                    <TextView
                        android:id="@+id/tv_active_cases"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="7"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:layout_marginTop="6dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Active Cases"
                        android:textSize="13sp"
                        android:textColor="@color/muted_text"
                        android:layout_marginTop="6dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Row 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="120dp"
                    android:orientation="vertical"
                    android:background="@drawable/rounded_card_bg"
                    android:padding="14dp"
                    android:layout_marginEnd="8dp"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_calendar"
                        android:contentDescription="@string/desc_completed_today" />

                    <TextView
                        android:id="@+id/tv_completed_today"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:layout_marginTop="6dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Completed Today"
                        android:textSize="13sp"
                        android:textColor="@color/muted_text"
                        android:layout_marginTop="6dp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="120dp"
                    android:orientation="vertical"
                    android:background="@drawable/rounded_card_bg"
                    android:padding="14dp"
                    android:layout_marginStart="8dp"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_warning"
                        android:contentDescription="@string/desc_emergency_cases" />

                    <TextView
                        android:id="@+id/tv_emergency_cases"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:layout_marginTop="6dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Emergency Cases"
                        android:textSize="13sp"
                        android:textColor="@color/muted_text"
                        android:layout_marginTop="6dp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Quick Actions -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            android:layout_marginTop="18dp"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quick Actions"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <!-- Buttons: use drawableLeft icons (vector assets) -->
                <Button
                    android:id="@+id/btn_view_surveys"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/quick_btn_blue"
                    android:text="@string/action_view_surveys"
                    android:textColor="@android:color/white"
                    android:drawableLeft="@drawable/ic_person_outline"
                    android:drawablePadding="12dp"/>

                <!-- NEW: Surveys button -->
                <Button
                    android:id="@+id/btnSurveys"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/quick_btn_blue"
                    android:text="Conduct Survey"
                    android:textColor="@android:color/white"
                    android:drawableLeft="@drawable/ic_document"
                    android:drawablePadding="12dp"/>

                <Button
                    android:id="@+id/btn_health_drives"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/quick_btn_teal"
                    android:text="@string/action_health_drives"
                    android:textColor="@android:color/white"
                    android:drawableLeft="@drawable/ic_send"
                    android:drawablePadding="12dp"/>

                <Button
                    android:id="@+id/btn_register_patient"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/quick_btn_green"
                    android:text="@string/action_register_patient"
                    android:textColor="@android:color/white"
                    android:drawableLeft="@drawable/ic_person_add"
                    android:drawablePadding="12dp"/>

                <Button
                    android:id="@+id/btn_help_login"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/quick_btn_purple"
                    android:text="@string/action_help_login"
                    android:textColor="@android:color/white"
                    android:drawableLeft="@drawable/ic_login_24"
                    android:drawablePadding="12dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Patient Services card (small grid) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            android:layout_marginTop="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <!-- Patient Services title -->
                <TextView
                    android:text="Patient Services"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="72dp"
                        android:orientation="vertical"
                        android:background="@drawable/program_item_bg"
                        android:gravity="center"
                        android:layout_marginEnd="8dp">
                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_robot"
                            android:contentDescription="@string/desc_patient_services"/>
                        <TextView
                            android:text="Patient Services"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"/>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="72dp"
                        android:orientation="vertical"
                        android:background="@drawable/program_item_bg"
                        android:gravity="center"
                        android:layout_marginStart="8dp">
                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_stethoscope"
                            android:contentDescription="@string/desc_consult_doctor"/>
                        <TextView
                            android:text="Consult Doctor"
                            android:textSize="13sp"
                            android:textColor="@color/muted_text"
                            android:layout_marginTop="8dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- second row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="72dp"
                        android:orientation="vertical"
                        android:background="@drawable/program_item_bg"
                        android:gravity="center"
                        android:layout_marginEnd="8dp">
                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_document"
                            android:contentDescription="@string/desc_past_consultations"/>
                        <TextView
                            android:text="Past Consultations"
                            android:textSize="13sp"
                            android:textColor="@color/muted_text"
                            android:layout_marginTop="8dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="72dp"
                        android:orientation="vertical"
                        android:background="@drawable/program_item_bg"
                        android:gravity="center"
                        android:layout_marginStart="8dp">
                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_analytics"
                            android:contentDescription="@string/desc_disease_analytics"/>
                        <TextView
                            android:text="Disease Analytics"
                            android:textSize="13sp"
                            android:textColor="@color/muted_text"
                            android:layout_marginTop="8dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Emergency button -->
                <Button
                    android:id="@+id/btn_emergency"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/asha_red"
                    android:background="@drawable/quick_btn_blue"
                    android:text="Emergency"
                    android:textColor="@android:color/white"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- My Area card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">
                <TextView
                    android:text="My Area"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="10dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_weight="1"
                            android:layout_width="0dp"
                            android:text="Coverage Area"
                            android:textColor="@color/muted_text"
                            android:layout_height="wrap_content"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:text="Village Block 1"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">
                        <TextView
                            android:layout_weight="1"
                            android:layout_width="0dp"
                            android:text="ASHA Worker ID"
                            android:textColor="@color/muted_text"
                            android:layout_height="wrap_content"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:text="A001"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">
                        <TextView
                            android:layout_weight="1"
                            android:layout_width="0dp"
                            android:text="Phone Number"
                            android:textColor="@color/muted_text"
                            android:layout_height="wrap_content"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:text="+91-9876543212"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Recent Activity (simple mock) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">
                <TextView
                    android:text="Recent Activity"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="12dp">
                    <TextView
                        android:text="• Patient registered — राम शर्मा • 2 hours ago"
                        android:textColor="@color/muted_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:layout_marginTop="8dp"
                        android:text="• Consultation completed — सीता देवी • 5 hours ago"
                        android:textColor="@color/muted_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:layout_marginTop="8dp"
                        android:text="• Emergency case referred — मोहन गुप्ता • 1 day ago"
                        android:textColor="@color/muted_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- National Health Programs hero -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_gradient_programs"
                android:padding="16dp">
                <TextView
                    android:text="National Health Programs"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:text="Major health schemes by Government of India"
                    android:layout_marginTop="6dp"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <Button
                    android:id="@+id/btn_view_programs"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/program_item_bg"
                    android:text="View All Programs"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Small list of programs (mock) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="10dp">
            <!-- each child is a small rounded row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/program_item_bg"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:layout_marginTop="8dp">
                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_apple"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="@string/desc_ayush"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:text="AYUSH - National AYUSH Mission"
                        android:textSize="14sp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:text="Promoting traditional medicine systems and practices"
                        android:textColor="@color/muted_text"
                        android:textSize="12sp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_open_in_new"
                    android:contentDescription="@string/desc_open_link"/>
            </LinearLayout>

            <!-- more items... -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/program_item_bg"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:layout_marginTop="8dp">
                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_heart"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="@string/desc_idsp"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:text="Integrated Disease Surveillance Project"
                        android:textSize="14sp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:text="Early detection and response to disease outbreaks (IDSP)"
                        android:textColor="@color/muted_text"
                        android:textSize="12sp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_open_in_new"
                    android:contentDescription="@string/desc_open_link"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Community Health Tips -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">
                <TextView
                    android:text="Community Health Tips"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="12dp">
                    <TextView
                        android:background="@drawable/tip_blue_bg"
                        android:padding="10dp"
                        android:text="Monsoon Health\nEnsure clean drinking water and prevent waterborne diseases."
                        android:textColor="@color/muted_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:layout_marginTop="8dp"
                        android:background="@drawable/tip_blue_bg"
                        android:padding="10dp"
                        android:text="Vaccination Drive\nRemind families about upcoming vaccination schedules."
                        android:textColor="@color/muted_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:layout_marginTop="8dp"
                        android:background="@drawable/tip_blue_bg"
                        android:padding="10dp"
                        android:text="Diabetes Awareness\nRegular screening for diabetes in adults above 30 years."
                        android:textColor="@color/muted_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Hidden placeholders so code that looks up these IDs doesn't crash -->
        <Button
            android:id="@+id/btn_open_maternal"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"/>

        <Button
            android:id="@+id/btn_open_vaccination"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="18dp"/>
    </LinearLayout>
</ScrollView>
