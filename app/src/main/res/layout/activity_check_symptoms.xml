<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools" android:id="@+id/rootLayout" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#FFFFFF" tools:context=".ui.ai_symptom.CheckSymptomsActivity">

    <!-- Header -->
    <LinearLayout android:id="@+id/header" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="16dp" android:background="#F5F5F5" android:gravity="center_vertical">

        <ImageView android:id="@+id/backButton" android:layout_width="32dp" android:layout_height="32dp" android:padding="6dp" android:src="@drawable/ic_arrow_back_24" android:contentDescription="Back" />

        <TextView android:id="@+id/tvHeader" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AI Symptom Checker" android:textSize="18sp" android:textStyle="bold" android:layout_marginStart="12dp" />

    </LinearLayout>

    <!-- Chat area -->
    <ScrollView android:id="@+id/scrollArea" android:layout_below="@id/header" android:layout_above="@id/bottomInputBox" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="12dp">

        <LinearLayout android:id="@+id/chatContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

            <!-- Messages will be added dynamically here -->

        </LinearLayout>
    </ScrollView>

    <!-- Bottom input box -->
    <LinearLayout android:id="@+id/bottomInputBox" android:layout_alignParentBottom="true" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:background="#F5F5F5">

        <LinearLayout android:layout_width="match_parent" android:layout_height="50dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/input_field_bg" android:paddingHorizontal="12dp">

            <EditText android:id="@+id/etSymptoms" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:hint="Describe your symptoms..." android:background="@android:color/transparent" android:padding="0dp" android:textSize="15sp" android:textColor="#1E293B" />

            <ImageView android:id="@+id/btnMic" android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_mic" android:layout_marginStart="6dp" android:contentDescription="Mic" />

            <ImageView android:id="@+id/btnSend" android:layout_width="42dp" android:layout_height="42dp" android:src="@drawable/ic_send" android:layout_marginStart="10dp" android:background="@drawable/send_button_bg" android:padding="10dp" android:contentDescription="Send" />
        </LinearLayout>

        <!-- Optional follow-up input -->
        <LinearLayout android:id="@+id/followupContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="8dp">

            <EditText android:id="@+id/etFollowupAnswer" android:layout_width="0dp" android:layout_weight="1" android:layout_height="50dp" android:hint="Follow-up answer..." android:background="@drawable/input_field_bg" android:padding="12dp" android:textColor="#1E293B" android:textSize="15sp"/>

            <Button android:id="@+id/btnSendFollowup" android:layout_width="50dp" android:layout_height="50dp" android:text="Send" />
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
