<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#DBEAFE" android:centerColor="#BFDBFE" android:endColor="#93C5FD" android:angle="135" />
        </shape>
    </item>

    <!-- Bottom border -->
    <item android:top="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <stroke android:width="2dp" android:color="#60A5FA" />
        </shape>
    </item>
</layer-list>
