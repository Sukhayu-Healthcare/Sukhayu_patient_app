<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">


    <!-- Network + basic permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Camera and Storage permissions for image picking -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <!-- Additions for audio recording -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application android:name="com.sukhayu.SukhayuApplication" android:allowBackup="true" android:icon="@drawable/asha_jyoti_app_logo" android:label="@string/app_name" android:theme="@style/Theme.RoleBasedTelemedicinePatient" android:supportsRtl="true">

        <!-- Login: Launcher activity -->
        <activity android:name="com.sukhayu.patient.ui.login.LoginActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Core Patient Screens -->
        <activity android:name="com.sukhayu.patient.ui.dashboard.DashboardActivity" android:exported="true" />
        <activity android:name="com.sukhayu.patient.ui.profile.ProfileActivity" android:exported="true" />
        <activity android:name="com.sukhayu.patient.ui.consultation.ConsultDoctorActivity" android:exported="true" />
        <activity android:name="com.sukhayu.patient.ui.consultation.PastConsultationsActivity" android:exported="true" />
        <activity android:name="com.sukhayu.patient.ui.consultation.DoctorDetailActivity" android:exported="false" />

        <!-- WebRTC Video Call Activity -->
        <activity android:name="com.sukhayu.patient.ui.consultation.VideoCallActivity" android:exported="false" android:screenOrientation="portrait" android:configChanges="orientation|keyboardHidden|screenSize" />

        <!-- AI Symptom Checker -->
        <activity android:name="com.sukhayu.patient.ui.ai_symptom.SymptomChatActivity" android:exported="true" />
        <activity android:name="com.sukhayu.patient.ui.ai_symptom.CheckSymptomsActivity" android:exported="true"/>

        <!-- Prescription / Consultation -->
        <activity android:name="com.sukhayu.patient.ui.consultation.PrescriptionActivity" android:exported="true" />

        <!-- Health Awareness -->
        <activity android:name="com.sukhayu.patient.ui.awareness.DiseaseOutbreakActivity" android:exported="true" />

        <!-- Supervisor -->
        <activity android:name="com.sukhayu.patient.ui.supervisor.dashboard.SupervisorHomeActivity" android:exported="true"/>
        <activity android:name="com.sukhayu.patient.ui.supervisor.registration.RegisterAshaActivity" android:exported="true"/>
        <activity android:name="com.sukhayu.patient.ui.supervisor.profile.AshaProfileActivity" android:exported="true" />
        <activity android:name="com.sukhayu.patient.ui.supervisor.profile.SupervisorAshaProfileActivity" android:exported="true" />
        <activity android:name=".ui.supervisor.ViewAshaDataActivity" android:exported="false" />
        <activity android:name="com.sukhayu.patient.ui.supervisor.surveys.CreateSurveyActivity" android:exported="false" />
        <activity android:name="com.sukhayu.patient.ui.supervisor.drives.CreateDriveActivity" android:exported="false" />
        <activity android:name="com.sukhayu.patient.ui.supervisor.ViewSurveysAndDrivesActivity" android:exported="true" />

        <!-- ASHA Dashboard (non-launcher) -->
        <activity android:name="com.sukhayu.patient.ui.asha.dashboard.AshaDashboardActivity" android:exported="true"/>

        <!-- ASHA Register Patient Activity -->
        <activity android:name="com.sukhayu.patient.ui.asha.registration.RegisterPatientActivity" android:exported="false" android:label="Register Patient" />

        <!-- ASHA Survey Home Activity -->
        <activity android:name="com.sukhayu.patient.asha.ui.surveys.AshaSurveyHomeActivity" android:exported="false" android:label="Surveys" />

        <!-- Pregnancy / ANC Survey Activity -->
        <activity android:name="com.sukhayu.patient.asha.ui.surveys.pregnancy.PregnancySurveyActivity" android:exported="false" android:label="Pregnancy / ANC Survey" />

        <!-- First ANC Visit Activity -->
        <activity android:name="com.sukhayu.patient.asha.ui.surveys.pregnancy.FirstAncVisitActivity" android:exported="false" android:label="First ANC Visit" />

        <!-- Follow-up ANC Visit Activity -->
        <activity android:name="com.sukhayu.patient.asha.ui.surveys.pregnancy.FollowUpAncVisitActivity" android:exported="false" android:label="Follow-up ANC Visit" />

        <!-- Child Health Survey Activity -->
        <activity android:name="com.sukhayu.patient.asha.ui.surveys.child.ChildSurveyActivity" android:exported="false" android:label="Child Health &amp; Immunisation" />

        <!-- TB Survey Activity -->
        <activity android:name="com.sukhayu.patient.asha.ui.surveys.tb.TbSurveyActivity" android:exported="false" android:label="TB Symptoms Survey" />

        <!-- TB Screening Form Activity -->
        <activity android:name="com.sukhayu.patient.asha.ui.surveys.tb.TbScreeningActivity" android:exported="false" android:label="TB Screening / Suspect Form" />

        <!-- TB Treatment Follow-up (DOTS) Activity -->
        <activity android:name="com.sukhayu.patient.asha.ui.surveys.tb.TbFollowUpActivity" android:exported="false" android:label="TB Treatment Follow-up (DOTS)" />

        <!-- Patient Search for General Survey -->
        <activity android:name="com.sukhayu.patient.ui.asha.search.PatientSearchForGeneralSurveyActivity" android:exported="false" android:label="Search Patient - General Survey" />

        <!-- General Survey Activity -->
        <activity android:name="com.sukhayu.patient.asha.ui.surveys.general_survey.GeneralSurveyActivity" android:exported="false" android:label="General Screening" />
        <activity android:name="com.sukhayu.patient.ui.supervisor.AshaDetailActivity" android:exported="true" />

        <!-- Add FileProvider -->
        <provider android:name="androidx.core.content.FileProvider" android:authorities="${applicationId}.fileprovider" android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
